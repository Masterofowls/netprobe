{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetProbe",
  "version": "1.5.3",
  "identifier": "com.netprobe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetProbe",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Network connectivity monitor",
    "longDescription": "Monitor websites and online services in real time. Check latency, DNS, TLS certificates, and availability from your network.",
    "category": "Utility"
  }
}
